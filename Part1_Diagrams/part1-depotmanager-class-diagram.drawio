        <mxCell id="0tWo3IW7MwweKQ_U23Ty-1195" parent="WIyWlLk6GJQsqaUBKTNV-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=58;fontColor=light-dark(#000000,#000000);" value="DepotManager Class Diagram" vertex="1">
          <mxGeometry height="30" width="1240" x="880" y="-420" as="geometry" />
        </mxCell>
        <mxCell id="0tWo3IW7MwweKQ_U23Ty-1196" parent="WIyWlLk6GJQsqaUBKTNV-1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;rounded=0;fontSize=16;fillStyle=solid;fillColor=default;fontColor=light-dark(#000000,#000000);" value="&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;ParcelMap and CustomerQueue are container classes. ParcelMap uses a LinkedHashMap&amp;lt;String, Parcel&amp;gt;, keyed by parcel ID, because it provides efficient lookup while preserving insertion order. CustomerQueue uses a Queue&amp;lt;Customer&amp;gt; backed by a LinkedList because it maintains the required first-in-first-out order.&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;Log applies the Singleton pattern so that the application uses one shared event log. DataLoader and ReportWriter are utility classes. DepotListener defines the observer interface implemented by DepotManagerFrame, allowing the presentation to refresh when the controller reports a change without placing presentation logic inside the model.&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="345" width="1840" x="590" y="-325" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
