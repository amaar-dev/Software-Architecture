        <mxCell id="WIyWlLk6GJQsqaUBKTNV-1" parent="WIyWlLk6GJQsqaUBKTNV-0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection TB\n\nclass Parcel {\n    -id: String\n    -weight: double\n    -length: double\n    -width: double\n    -height: double\n    -daysInDepot: int\n    -collected: boolean\n    +Parcel(id: String, weight: double, length: double, width: double, height: double, daysInDepot: int)\n    +setCollected(collected: boolean): void\n    +getVolume(): double\n}\n\nclass Customer {\n    -sequenceNumber: int\n    -name: String\n    -parcelId: String\n    +Customer(sequenceNumber: int, name: String, parcelId: String)\n}\n\nclass ParcelMap {\n    -parcels: Map~String, Parcel~\n    +addParcel(parcel: Parcel): void\n    +getParcel(id: String): Parcel\n    +containsParcel(id: String): boolean\n    +removeParcel(id: String): Parcel\n    +size(): int\n    +getAllParcels(): List~Parcel~\n    +getUncollectedParcels(): List~Parcel~\n    +getUncollectedSortedByDaysInDepot(): List~Parcel~\n}\n\nclass CustomerQueue {\n    -queue: Queue~Customer~\n    +enqueue(customer: Customer): void\n    +dequeue(): Customer\n    +peek(): Customer\n    +isEmpty(): boolean\n    +size(): int\n    +removeBySequenceNumber(sequenceNumber: int): boolean\n    +getQueueSnapshot(): List~Customer~\n}\n\nclass Worker {\n    -name: String\n    +Worker(name: String)\n    +calculateFee(parcel: Parcel): double\n    +processNextCustomer(queue: CustomerQueue, parcels: ParcelMap): ProcessingResult\n}\n\nclass ProcessingResult {\n    -success: boolean\n    -message: String\n    -customer: Customer\n    -parcel: Parcel\n    -fee: double\n    +success(customer: Customer, parcel: Parcel, fee: double): ProcessingResult\n    +failure(message: String): ProcessingResult\n    +isSuccess(): boolean\n    +getMessage(): String\n    +getCustomer(): Customer\n    +getParcel(): Parcel\n    +getFee(): double\n}\n\nclass Log {\n    -instance: Log\n    -buffer: StringBuffer\n    -Log()\n    +getInstance(): Log\n    +logEvent(message: String): void\n    +getLogContents(): String\n    +writeToFile(filePath: String): void\n    +clear(): void\n}\n\nclass InvalidParcelDataException {\n    +InvalidParcelDataException(message: String)\n}\n\nclass Exception\n\nclass DepotController {\n    -parcelMap: ParcelMap\n    -customerQueue: CustomerQueue\n    -worker: Worker\n    -listeners: List~DepotListener~\n    +DepotController(parcelMap: ParcelMap, customerQueue: CustomerQueue, worker: Worker)\n    +addListener(listener: DepotListener): void\n    +removeListener(listener: DepotListener): void\n    -notifyListeners(): void\n    +getParcelMap(): ParcelMap\n    +getCustomerQueue(): CustomerQueue\n    +addParcel(parcel: Parcel): void\n    +addCustomerToQueue(customer: Customer): void\n    +processNextCustomer(): ProcessingResult\n    +loadParcelsFromFile(filePath: String): void\n    +loadCustomersFromFile(filePath: String): void\n    +endDay(reportFilePath: String, logFilePath: String): void\n}\n\nclass DepotListener {\n    +onDepotUpdated(): void\n}\n\nclass DataLoader {\n    +loadParcels(filePath: String): List~Parcel~\n    +loadCustomers(filePath: String): List~Customer~\n}\n\nclass ReportWriter {\n    +writeReport(filePath: String, parcelMap: ParcelMap): void\n}\n\nclass DepotManagerFrame {\n    -controller: DepotController\n    -parcelListPanel: ParcelListPanel\n    -customerQueuePanel: CustomerQueuePanel\n    -processingPanel: ProcessingPanel\n    +DepotManagerFrame(controller: DepotController)\n    +onDepotUpdated(): void\n}\n\nclass ControlPanel {\n    -processNextButton: JButton\n    -endDayButton: JButton\n    +ControlPanel(controller: DepotController, processingPanel: ProcessingPanel)\n}\n\nclass ProcessingPanel {\n    -detailsArea: JTextArea\n    +ProcessingPanel()\n    +showResult(result: ProcessingResult): void\n}\n\nclass ParcelListPanel {\n    -listModel: DefaultListModel~String~\n    -parcelList: JList~String~\n    +ParcelListPanel()\n    +refresh(parcelMap: ParcelMap): void\n}\n\nclass CustomerQueuePanel {\n    -listModel: DefaultListModel~String~\n    -queueList: JList~String~\n    +CustomerQueuePanel()\n    +refresh(customerQueue: CustomerQueue): void\n}\n\nclass DepotManagerApp {\n    +main(args: String[]): void\n}\n\nInvalidParcelDataException --|&gt; Exception\nDepotManagerFrame ..|&gt; DepotListener\n\nParcelMap \&quot;1\&quot; *-- \&quot;0..*\&quot; Parcel : parcels\nCustomerQueue \&quot;1\&quot; o-- \&quot;0..*\&quot; Customer : waitingCustomers\n\nDepotController \&quot;1\&quot; -- \&quot;1\&quot; ParcelMap\nDepotController \&quot;1\&quot; -- \&quot;1\&quot; CustomerQueue\nDepotController \&quot;1\&quot; -- \&quot;1\&quot; Worker\nDepotController \&quot;1\&quot; -- \&quot;0..*\&quot; DepotListener\n\nWorker ..&gt; ProcessingResult\nWorker ..&gt; CustomerQueue\nWorker ..&gt; ParcelMap\nWorker ..&gt; Log\n\nProcessingResult \&quot;0..*\&quot; -- \&quot;0..1\&quot; Customer\nProcessingResult \&quot;0..*\&quot; -- \&quot;0..1\&quot; Parcel\n\nDepotController ..&gt; DataLoader\nDepotController ..&gt; ReportWriter\nDepotController ..&gt; Log\n\nDepotManagerFrame \&quot;1\&quot; *-- \&quot;1\&quot; ParcelListPanel\nDepotManagerFrame \&quot;1\&quot; *-- \&quot;1\&quot; CustomerQueuePanel\nDepotManagerFrame \&quot;1\&quot; *-- \&quot;1\&quot; ProcessingPanel\nDepotManagerFrame \&quot;1\&quot; *-- \&quot;1\&quot; ControlPanel\n\nDepotManagerFrame \&quot;1\&quot; -- \&quot;1\&quot; DepotController\nControlPanel \&quot;1\&quot; -- \&quot;1\&quot; DepotController\nControlPanel \&quot;1\&quot; -- \&quot;1\&quot; ProcessingPanel\n\nDepotManagerApp ..&gt; DepotController\nDepotManagerApp ..&gt; DepotManagerFrame&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="0tWo3IW7MwweKQ_U23Ty-1006">
